# Client-side — baked into the public bundle by Vite (see src/constants.js).
# Only GATSBY_- and FATHOM_-prefixed vars are exposed (envPrefix in
# vite.config.js), so never put a secret behind those prefixes.
GATSBY_USERBASE_APP_ID=<userbase_app_id>
GATSBY_USERBASE_SESSION_LENGTH=<userbase_session_length_hours>

GATSBY_STRIPE_KEY=<stripe_publishable_key>
GATSBY_STRIPE_MONTHLY_PLAN_ID=<stripe_monthly_price_id>
GATSBY_STRIPE_YEARLY_PLAN_ID=<stripe_yearly_price_id>

# Optional Fathom goal ids: GATSBY_FATHOM_ONBOARDING_1..4, GATSBY_FATHOM_FEEDBACK,
# GATSBY_FATHOM_CHANGELOG, GATSBY_FATHOM_MADE_BY, GATSBY_FATHOM_SUPPORT,
# GATSBY_FATHOM_EXPORT, GATSBY_FATHOM_DELETE_ALL_MENSES_TAGS,
# GATSBY_FATHOM_DELETE_ALL_ENTRIES, GATSBY_FATHOM_DELETE_ALL_ENTRIES_CONFIRMED

# Analytics — the Fathom tracker only loads when a site id is set
# (src/features/tracking/index.js).
FATHOM_SITE=<fathom_site_id>
FATHOM_INCLUDED_DOMAINS=my.usepow.app

# Netlify function runtime (netlify/functions) — never exposed to the client.
# Each supports optional _PRODUCTION/_DEPLOY_PREVIEW/_DEVELOPMENT variants,
# resolved per request context (netlify/functions-lib/user/middleware/contextManager.js).
STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SUBSCRIBED_SECRET=<stripe_webhook_signing_secret>
USERBASE_ADMIN_API_ACCESS_TOKEN=<userbase_admin_api_access_token>
CONVERTKIT_API_SECRET=<convertkit_api_secret>
CONVERTKIT_FORM_ID=<convertkit_form_id>
SENTRY_DSN=<sentry_dsn>
